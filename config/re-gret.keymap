
/*
 * Re-gret – 34 key split keyboard
 * Layout: QWERTY International
 *
 * Layers:
 * 0: ALPHA
 * 1: NUM
 * 2: NAV
 * 3: SYM
 * 4: SYS
 *
 * Thumb keys:
 * Left upper:  Space / NUM
 * Left lower:  Backspace / SYM
 * Right upper: Enter / NAV
 * Right lower: Escape / SYS
 *
 * Home row mods:
 * Left:  A GUI, S ALT, D SHIFT, F CTRL
 * Right: J CTRL, K SHIFT, L ALT, ; GUI
 *
 * No sticky keys or one-shot modifiers.
 */

#include <behaviors.dtsi>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/bt.h>

/ {
    keymap {
        compatible = "zmk,keymap";

        /* =========================================
         * LAYER 0: ALPHA
         * ========================================= */

        default_layer {
            display-name = "ALPHA";

            bindings = <
                &kp Q      &kp W      &kp E      &kp R      &kp T
                &kp Y      &kp U      &kp I      &kp O      &kp P

                &mt LCTRL A &mt LGUI S &mt LALT D &mt RSHFT F &mt RALT G
                &mt RALT H      &mt RSHFT J &mt LALT K &mt LGUI L &mt LCTRL SEMI

                &kp Z      &kp X      &kp C      &kp V      &kp B
                &kp N      &kp M      &kp COMMA  &kp DOT    &kp FSLH

                &lt 1 SPACE
                &lt 3 BACKSPACE
                &lt 2 ENTER
                &lt 4 ESC
            >;
        };

        /* =========================================
         * LAYER 1: NUMBERS
         * ========================================= */

        num_layer {
            display-name = "NUM";

            bindings = <
                &kp N1     &kp N2     &kp N3     &kp N4     &kp N5
                &kp N6     &kp N7     &kp N8     &kp N9     &kp N0

                &mt LCTRL MINUS &mt LGUI EQUAL &mt LALT LBKT &mt RSHFT RBKT &mt RALT BSLH
                &mt RALT LEFT   &mt RSHFT J &mt LALT K &mt LGUI L &mt LCTRL SEMI

                &kp F1     &kp F2     &kp F3     &kp F4     &kp F5
                &kp F6     &kp F7     &kp F8     &kp F9     &kp F10

                &lt 1 SPACE
                &lt 3 BACKSPACE
                &lt 2 ENTER
                &lt 4 ESC
            >;
        };

        /* =========================================
         * LAYER 2: NAVIGATION
         * ========================================= */

        nav_layer {
            display-name = "NAV";

            bindings = <
                &kp HOME   &kp PG_DN  &kp PG_UP  &kp END    &kp INS
                &kp DEL    &trans &trans &trans   &trans

                &mt LCTRL A &mt LGUI S &mt LALT D &mt RSHFT F &mt RALT TAB
                &trans   &kp LEFT &kp UP &kp RIGHT &kp TAB

                &trans    &trans    &trans    &trans    &trans
                &trans   &kp LEFT   &kp DOWN     &kp RIGHT  &kp TAB

                &lt 1 SPACE
                &lt 3 BACKSPACE
                &lt 2 ENTER
                &lt 4 ESC
            >;
        };

        /* =========================================
         * LAYER 3: SYMBOLS
         * ========================================= */

        sym_layer {
            display-name = "SYM";

            bindings = <
                &kp EXCL   &kp AT     &kp HASH   &kp DLLR   &kp PRCNT
                &kp CARET  &kp AMPS   &kp ASTRK  &kp LPAR   &kp RPAR

                &mt LCTRL GRAVE &mt LGUI TILDE &mt LALT LBRC &mt LSHFT RBRC &kp PIPE
                &kp MINUS  &mt LSHFT UNDER &mt LALT PLUS &mt LGUI EQUAL &mt RCTRL COLON

                &kp SEMI   &kp DQT    &kp APOS   &kp LT     &kp GT
                &kp QMARK  &kp FSLH   &kp BSLH   &kp LBKT   &kp RBKT

                &lt 1 SPACE
                &lt 3 BACKSPACE
                &lt 2 ENTER
                &lt 4 ESC
            >;
        };

        /* =========================================
         * LAYER 4: SYSTEM
         * ========================================= */

        sys_layer {
            display-name = "SYS";

            bindings = <
                &kp F11    &kp F12    &kp F13    &kp F14    &kp F15
                &kp F16    &kp F17    &kp F18    &kp F19    &kp F20

                &trans &trans &trans &trans &kp CAPS
                &kp C_MUTE &trans &trans &trans &trans

                &bt BT_SEL 0
                &bt BT_SEL 1
                &bt BT_SEL 2
                &studio_unlock
                &bt BT_CLR

                &kp C_VOL_DN
                &kp C_VOL_UP
                &bootloader
                &sys_reset
                &kp C_PLAY_PAUSE

                &lt 1 SPACE
                &lt 3 BACKSPACE
                &lt 2 ENTER
                &lt 4 ESC
            >;
        };
    };
};
