
/*
 * Re-gret – 34 key split keyboard
 * Layout: QWERTY International
 *
 * Layers:
 * 0: ALPHA
 * 1: NUM
 * 2: NAV
 * 3: SYM
 * 4: SYS
 *
 * Thumb keys:
 * Left upper:  Space / NUM
 * Left lower:  Backspace / SYM
 * Right upper: Enter / NAV
 * Right lower: Escape / SYS
 *
 * Home row mods:
 * Left:  A GUI, S ALT, D SHIFT, F CTRL
 * Right: J CTRL, K SHIFT, L ALT, ; GUI
 *
 * No sticky keys or one-shot modifiers.
 */

#include <behaviors.dtsi>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/bt.h>

/ {
    keymap {
        compatible = "zmk,keymap";

        /* =========================================
         * LAYER 0: ALPHA
         * ========================================= */

        default_layer {
            display-name = "ALPHA";

            bindings = <
                &kp Q      &kp W      &kp E      &kp R      &kp T
                &kp Y      &kp U      &kp I      &kp O      &kp P

                &mt LGUI A &mt LALT S &mt LSHFT D &mt LCTRL F &kp G
                &kp H      &mt RCTRL J &mt RSHFT K &mt RALT L &mt RGUI SEMI

                &kp Z      &kp X      &kp C      &kp V      &kp B
                &kp N      &kp M      &kp COMMA  &kp DOT    &kp FSLH

                &lt 1 SPACE
                &lt 3 BACKSPACE
                &lt 2 ENTER
                &lt 4 ESC
            >;
        };

        /* =========================================
         * LAYER 1: NUMBERS
         * ========================================= */

        num_layer {
            display-name = "NUM";

            bindings = <
                &kp N1     &kp N2     &kp N3     &kp N4     &kp N5
                &kp N6     &kp N7     &kp N8     &kp N9     &kp N0

                &mt LGUI MINUS &mt LALT EQUAL &mt LSHFT LBKT &mt LCTRL RBKT &kp BSLH
                &kp LEFT   &mt RCTRL J &mt RSHFT K &mt RALT L &mt RGUI SEMI

                &kp F1     &kp F2     &kp F3     &kp F4     &kp F5
                &kp F6     &kp F7     &kp F8     &kp F9     &kp F10

                &lt 1 SPACE
                &lt 3 BACKSPACE
                &lt 2 ENTER
                &lt 4 ESC
            >;
        };

        /* =========================================
         * LAYER 2: NAVIGATION
         * ========================================= */

        nav_layer {
            display-name = "NAV";

            bindings = <
                &kp HOME   &kp PG_DN  &kp PG_UP  &kp END    &kp INS
                &kp DEL    &kp C_LEFT &kp C_DOWN &kp C_UP   &kp C_RIGHT

                &mt LGUI A &mt LALT S &mt LSHFT D &mt LCTRL F &kp TAB
                &kp LEFT   &mt RCTRL J &mt RSHFT K &mt RALT L &mt RGUI SEMI

                &kp C_Z    &kp C_X    &kp C_C    &kp C_V    &kp C_Y
                &kp LEFT   &kp DOWN   &kp UP     &kp RIGHT  &kp TAB

                &lt 1 SPACE
                &lt 3 BACKSPACE
                &lt 2 ENTER
                &lt 4 ESC
            >;
        };

        /* =========================================
         * LAYER 3: SYMBOLS
         * ========================================= */

        sym_layer {
            display-name = "SYM";

            bindings = <
                &kp EXCL   &kp AT     &kp HASH   &kp DLLR   &kp PRCNT
                &kp CARET  &kp AMPS   &kp ASTRK  &kp LPAR   &kp RPAR

                &mt LGUI GRAVE &mt LALT TILDE &mt LSHFT LBRC &mt LCTRL RBRC &kp PIPE
                &kp MINUS  &mt RCTRL UNDER &mt RSHFT PLUS &mt RALT EQUAL &mt RGUI COLON

                &kp SEMI   &kp DQT    &kp APOS   &kp LT     &kp GT
                &kp QMARK  &kp FSLH   &kp BSLH   &kp LBKT   &kp RBKT

                &lt 1 SPACE
                &lt 3 BACKSPACE
                &lt 2 ENTER
                &lt 4 ESC
            >;
        };

        /* =========================================
         * LAYER 4: SYSTEM
         * ========================================= */

        sys_layer {
            display-name = "SYS";

            bindings = <
                &kp F11    &kp F12    &kp F13    &kp F14    &kp F15
                &kp F16    &kp F17    &kp F18    &kp F19    &kp F20

                &mt LGUI A &mt LALT S &mt LSHFT D &mt LCTRL F &kp CAPS
                &kp C_MUTE &mt RCTRL J &mt RSHFT K &mt RALT L &mt RGUI SEMI

                &bt BT_SEL 0
                &bt BT_SEL 1
                &bt BT_SEL 2
                &bt BT_SEL 3
                &bt BT_CLR

                &kp C_VOL_DN
                &kp C_VOL_UP
                &bootloader
                &sys_reset
                &kp C_PLAY_PAUSE

                &lt 1 SPACE
                &lt 3 BACKSPACE
                &lt 2 ENTER
                &lt 4 ESC
            >;
        };
    };
};
