#include <behaviors.dtsi>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/rgb.h>
#include <dt-bindings/zmk/bt.h>

#define SYM_L 1
#define NAV_L 2
#define NUM_L 3
#define SYS_L 4

/ {
    conditional_layers {
        compatible = "zmk,conditional-layers";
        cond_1_2_4 {
            if-layers = <1 2>;
            then-layer = <4>;
        };
    };

    behaviors {
        hm: homerow_mods {
            compatible = "zmk,behavior-hold-tap";
            #binding-cells = <2>;
            tapping-term-ms = <200>;
            flavor = "tap-preferred";
            bindings = <&kp>, <&kp>;
        };
    };
 
    #define COMBO_IDLE 175
    combos {
        compatible = "zmk,combos";

        // Activate system layer on inner thumbs

        bsp  { key-positions = <26 27>; bindings = <&kp BSPC>; require-prior-idle-ms = <COMBO_IDLE>;};
        semi { key-positions = <27 28>; bindings = <&kp SEMI>; require-prior-idle-ms = <COMBO_IDLE>;};

        // Brackets and parens
        vlbkt { key-positions = <1 11>; bindings = <&kp LBKT>; require-prior-idle-ms = <COMBO_IDLE>; };
        vlpar { key-positions = <2 12>; bindings = <&kp LPAR>; require-prior-idle-ms = <COMBO_IDLE>; };
        vlbrc { key-positions = <3 13>; bindings = <&kp LBRC>; require-prior-idle-ms = <COMBO_IDLE>; };
        vrbrc { key-positions = <6 16>; bindings = <&kp RBRC>; require-prior-idle-ms = <COMBO_IDLE>; };
        vrpar { key-positions = <7 17>; bindings = <&kp RPAR>; require-prior-idle-ms = <COMBO_IDLE>; };
        vrbkt { key-positions = <8 18>; bindings = <&kp RBKT>; require-prior-idle-ms = <COMBO_IDLE>; };

        comboEsc {
            timeout-ms = <50>;
            key-positions = <1 2 3>;
            bindings = <&kp ESC>;
        };
        comboenter {
            timeout-ms = <50>;
            key-positions = <6 7 8>;
            bindings = <&kp ENTER>;
        };
    };

    keymap {
        compatible = "zmk,keymap";

        default_layer {
            display-name = "Base";
            bindings = <
                &kp Q      &kp W      &kp E       &kp R          &kp T         &kp Y            &kp U          &kp I       &kp O      &kp P
                &hm LCTRL A      &hm LGUI S      &hm LALT D       &hm LSHFT F          &hm RALT G         &hm RALT H            &hm LSHFT J          &hm LALT K       &hm LGUI L      &hm LCTRL SQT
                &kp Z      &kp X      &kp C       &kp V          &kp B         &kp N            &kp M          &kp COMMA   &kp DOT    &kp FSLH
                                                  &lt 1 ESC      &lt 3 SPACE     &kp RSHIFT       &lt 2 ENTER
            >;
        };

        sym_layer {
            display-name = "Symbol";
            bindings = <
                &kp EXCL   &kp AT   &kp HASH   &kp DLLR          &kp LBRC      &kp RBRC       &kp PRCNT         &kp TILDE    &kp EQUAL     &kp K_APP
                &hm LCTRL AMPS  &hm LGUI STAR   &hm LALT PLUS   &hm LSHFT MINUS       &hm RALT LPAR      &hm RALT RPAR        &hm RSHFT DQT      &hm LALT SQT    &hm LGUI COLON   &hm LCTRL SEMI
                &kp PIPE   &kp CARET  &kp DLLR    &kp MINUS       &kp LBKT        &kp RBKT          &kp FSLH       &kp LT      &kp GT     &kp GRAVE
                                                  &trans          &trans        &trans          &trans
            >;
        };

        nav_layer {
            display-name = "Nav";
            bindings = <
                &trans      &trans      &trans     &trans         &kp TAB       &kp END          &kp PG_DN         &kp HOME      &kp PG_UP     &kp DEL
                &kp LCTRL   &kp LGUI    &kp LALT   &kp LSHFT      &mt RALT BSPC      &kp BSPC        &kp LEFT       &kp UP      &kp RIGHT  &kp TAB
                &kp LG(Z)   &kp LG(X)   &kp LG(C)  &kp LG(V)      &kp RET       &kp RET         &kp LEFT       &kp DOWN     &kp RIGHT     &trans
                                                   &trans         &trans        &trans          &trans
            >;
        };

        num_layer {
            display-name = "Number";
            bindings = <
                &kp PLUS      &kp N7     &kp N8    &kp N3        &kp MINUS      &kp TAB &kp COMMA        &kp DOT     &kp STAR       &kp SQT
                &kp KP_MULTIPLY  &kp N4  &kp N5  &kp N6  &kp KP_DIVIDE        &mt RALT ENTER    &kp RSHFT  &kp RCMD  &kp RALT  &kp RCTRL
                &kp N0      &kp N1       &kp N2     &kp N3     &kp KP_EQUAL        &kp BSPC    &trans      &trans    &trans   &trans
                                                        &trans        &trans        &trans    &trans
            >;
        };

        system_layer {
            display-name = "System";
            bindings = <
                &bootloader &studio_unlock &none   &none          &none         &rgb_ug RGB_TOG &kp C_BRI_UP          &kp C_BRI_DN        &none      &none
                &kp LCTRL   &kp LGUI    &kp LALT   &kp LSHFT      &kp RALT         &kp C_PREV      &kp C_VOL_DN   &kp C_VOL_UP &kp C_NEXT &none
                &bt BT_CLR  &none       &none      &none          &none         &none           &kp C_PP       &none        &none      &tog 5
                                                   &trans         &trans        &trans          &trans
            >;
        };
        gaming {
            bindings = <
                &kp TAB &kp Q &kp W &kp E &kp R &kp N1 &trans &kp UP &trans &kp ESC
                &kp LSHFT &kp A &kp S &kp D &kp F &kp N2 &kp LEFT &kp DOWN &kp RIGHT &trans
                &kp LCTRL &kp Y &kp X &kp C &kp V &kp N3 &trans &trans &trans &tog 0
                &kp SPACE &kp SPACE &trans &trans
            >;
        };
    };
};
